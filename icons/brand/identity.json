{
  "$comment": "Identidad visual de la familia de iconos. Todo icono generado hereda estos valores; cambia aquí y regenera para actualizar toda la familia.",
  "name": "Brand Icons",
  "canvas": { "size": 512, "fps": 60 },
  "grid": { "size": 24, "padding": 40 },
  "stroke": { "width": 1.75, "cap": "round", "join": "round" },
  "colors": {
    "primary": "#1B1B3A",
    "secondary": "#FF6B4A"
  },
  "motion": {
    "easing": {
      "out": [0.22, 1, 0.36, 1],
      "inOut": [0.65, 0, 0.35, 1],
      "overshoot": [0.34, 1.56, 0.64, 1]
    },
    "draw": { "duration": 36, "stagger": 8 },
    "pop": { "duration": 24, "amount": 0.12 },
    "wiggle": { "duration": 40, "angle": 14 },
    "bounce": { "duration": 36, "height": 1.6 },
    "spin": { "duration": 60 },
    "pulse": { "duration": 40, "amount": 0.08 },
    "hold": 12
  },
  "presets": {
    "reveal": ["draw", "pop"],
    "attention": ["wiggle"],
    "jump": ["bounce"],
    "loading": ["spin"],
    "heartbeat": ["pulse"]
  }
}
