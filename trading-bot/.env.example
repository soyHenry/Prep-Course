# Copiá este archivo como .env y completalo.

# paper   = simulado con precios reales de Binance, sin claves (RECOMENDADO para arrancar)
# testnet = órdenes reales en la cuenta de prueba de Binance (dinero ficticio, necesita claves de testnet)
# live    = DINERO REAL. Solo en enero y si los números lo justifican.
MODE=paper

SYMBOL=BTCUSDT
INTERVAL=1h
# Capital que el bot considera "suyo" (USDT). Aunque la cuenta tenga más, no opera por encima de esto.
CAPITAL=100

# Claves de https://testnet.binance.vision (solo para MODE=testnet)
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# Claves reales (solo para MODE=live). Crearlas SIN permiso de retiro.
BINANCE_KEY=
BINANCE_SECRET=
# Seguro adicional: el modo live no arranca si esto no dice exactamente "si"
CONFIRMO_DINERO_REAL=no

# Riesgo
RISK_PER_TRADE=0.02
DAILY_LOSS_LIMIT=0.05
MAX_DRAWDOWN=0.20
